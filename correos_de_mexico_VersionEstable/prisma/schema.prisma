  sluggable_type String?
  scope          String?
  is_primary     Boolean   @default(true)
  created_at     DateTime?
  deleted_at     DateTime?

  @@map("friendly_id_slugs")
}

model FriendlySlug {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String
  sluggable_id   String?   @db.Uuid
  sluggable_type String?
  scope          String?
  is_primary     Boolean   @default(true)
  created_at     DateTime?
  deleted_at     DateTime?

  @@map("cdm_friendly_slugs")
}

model Asset {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewable_type           String?
  viewable_id             String?   @db.Uuid
  attachment_width        Int?
  attachment_height       Int?
  attachment_file_size    Int?
  position                Int?
  attachment_content_type String?
  attachment_file_name    String?
  type                    String?
  attachment_updated_at   DateTime?
  alt                     String?   @db.Text
  created_at              DateTime?
  updated_at              DateTime?
  deleted_at              DateTime?

  @@map("cdm_assets")
}

model Calculator {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             String?
  calculable_type  String?
  calculable_id    String?   @db.Uuid
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  preferences      String?   @db.Text
  deleted_at       DateTime?

  @@map("cdm_calculators")
}

model Gateway {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String?
  name        String?
  description String?  @db.Text
  active      Boolean  @default(true)
  environment String   @default("development")
  server      String   @default("test")
  test_mode   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  preferences String?  @db.Text

  @@map("cdm_gateways")
}

model LogEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_type String?
  source_id   String?  @db.Uuid
  details     String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("cdm_log_entries")
}

model Preference {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  value      String?  @db.Text
  key        String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("cdm_preferences")
}

model Tracker {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analytics_id String?
  active       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  engine       Int      @default(0)

  @@map("cdm_trackers")
}

model StateChange {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?
  previous_state String?
  stateful_id    String?   @db.Uuid
  user_id        String?   @db.Uuid
  cdmUser        CdmUser?  @relation(fields: [user_id], references: [id])
  stateful_type  String?
  next_state     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@map("cdm_state_changes")
}

model Role {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String?
  created_at DateTime?
  updated_at DateTime?
  roleUsers  RoleUser[]

  @@map("cdm_roles")
}

model RoleUser {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id    String?   @db.Uuid
  role       Role?     @relation(fields: [role_id], references: [id])
  user_id    String?   @db.Uuid
  cdmUser    CdmUser?  @relation(fields: [user_id], references: [id])
  created_at DateTime?
  updated_at DateTime?

  @@map("cdm_role_users")
}

// ============================================
// POSTAL SYSTEM (NEW)
// ============================================

model PostalOffice {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String            @unique
  name                String
  office_type         String
  parent_office_id    String?           @db.Uuid
  parentOffice        PostalOffice?     @relation("OfficeHierarchy", fields: [parent_office_id], references: [id])
  childOffices        PostalOffice[]    @relation("OfficeHierarchy")
  stock_location_id   String?           @db.Uuid
  stockLocation       StockLocation?    @relation(fields: [stock_location_id], references: [id])
  address_id          String            @db.Uuid
  address             Address           @relation(fields: [address_id], references: [id])
  active              Boolean           @default(true)
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  postalGuidesAsOrigin PostalGuide[]    @relation("OriginOffice")
  postalManifestsAsOrigin PostalManifest[] @relation("ManifestOrigin")
  postalManifestsAsDest PostalManifest[] @relation("ManifestDestination")
  postalVehicles      PostalVehicle[]
  postalEvents        PostalEvent[]

  @@map("cdm_postal_offices")
}

model PostalGuide {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guide_number            String              @unique
  guide_type              String
  shipment_id             String              @unique @db.Uuid
  shipment                Shipment            @relation(fields: [shipment_id], references: [id])
  origin_office_id        String              @db.Uuid
  originOffice            PostalOffice        @relation("OriginOffice", fields: [origin_office_id], references: [id])
  destination_address_id  String              @db.Uuid
  destinationAddress      Address             @relation(fields: [destination_address_id], references: [id])
  current_status          String
  created_at              DateTime            @default(now())
  estimated_delivery_at   DateTime?
  postalEvents            PostalEvent[]
  postalManifestGuides    PostalManifestGuide[]

  @@map("cdm_postal_guides")
}

model PostalManifest {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manifest_number       String                @unique
  origin_office_id      String                @db.Uuid
  originOffice          PostalOffice          @relation("ManifestOrigin", fields: [origin_office_id], references: [id])
  destination_office_id String                @db.Uuid
  destinationOffice     PostalOffice          @relation("ManifestDestination", fields: [destination_office_id], references: [id])
  vehicle_id            String?               @db.Uuid
  vehicle               PostalVehicle?        @relation(fields: [vehicle_id], references: [id])
  driver_user_id        String?               @db.Uuid
  driverUser            CdmUser?              @relation(fields: [driver_user_id], references: [id])
  status                String?
  departure_at          DateTime?
  arrival_at            DateTime?
  created_at            DateTime              @default(now())
  postalManifestGuides  PostalManifestGuide[]
  postalEvents          PostalEvent[]

  @@map("cdm_postal_manifests")
}

model PostalManifestGuide {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  manifest_id String         @db.Uuid
  manifest    PostalManifest @relation(fields: [manifest_id], references: [id])
  guide_id    String         @db.Uuid
  guide       PostalGuide    @relation(fields: [guide_id], references: [id])
  scanned_at  DateTime?

  @@map("cdm_postal_manifest_guides")
}

model PostalVehicle {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_type    String
  plate_number    String?
  provider        String?
  base_office_id  String?          @db.Uuid
  baseOffice      PostalOffice?    @relation(fields: [base_office_id], references: [id])
  active          Boolean          @default(true)
  created_at      DateTime         @default(now())
  postalManifests PostalManifest[]

  @@map("cdm_postal_vehicles")
}

model PostalEvent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guide_id       String          @db.Uuid
  guide          PostalGuide     @relation(fields: [guide_id], references: [id])
  event_type     String
  office_id      String          @db.Uuid
  office         PostalOffice    @relation(fields: [office_id], references: [id])
  user_id        String?         @db.Uuid
  cdmUser        CdmUser?        @relation(fields: [user_id], references: [id])
  manifest_id    String?         @db.Uuid
  manifest       PostalManifest? @relation(fields: [manifest_id], references: [id])
  occurred_at    DateTime
  metadata       Json?
  is_correction  Boolean         @default(false)

  @@map("cdm_postal_events")
}

model PostalOfficeEventRule {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  office_type String
  event_type  String

  @@map("cdm_postal_office_event_rules")
}

// ============================================
// OUTBOX
// ============================================

model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventName   String
  eventId     String    @unique
  payload     Json
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  failedAt    DateTime?
  lastError   String?
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)

  @@map("cdm_outbox_events")
}

// ============================================
// PAYMENT WEBHOOK EVENTS
// ============================================

model PaymentWebhookEvent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gateway_code      String
  provider_event_id String    @unique
  event_type        String
  status            String    @default("PENDING")
  payment_id        String?   @db.Uuid
  payment           Payment?  @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  payment_intent_id String?
  payload           Json
  received_at       DateTime  @default(now())
  processed_at      DateTime?
  last_error        String?

  @@index([status])
  @@index([payment_id])
  @@index([payment_intent_id])
  @@map("cdm_payment_webhook_events")
}
