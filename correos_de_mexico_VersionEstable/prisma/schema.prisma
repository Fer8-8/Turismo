// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH MODELS (better-auth)
// ============================================

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================
// GEOGRAPHY & ADDRESS
// ============================================

model Country {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iso_name         String
  iso              String
  iso3             String
  name             String
  numcode          Int
  states_required  Boolean         @default(false)
  zipcode_required Boolean         @default(true)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  states           State[]
  addresses        Address[]       @relation("AddressToCountry")
  stockLocations   StockLocation[]
  stores           Store[]

  @@map("cdm_countries")
}

model State {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  abbr            String
  country_id      String?         @db.Uuid
  country         Country?        @relation(fields: [country_id], references: [id], onDelete: Cascade)
  updated_at      DateTime        @updatedAt
  created_at      DateTime        @default(now())
  addresses       Address[]
  stockLocations  StockLocation[]

  @@map("cdm_states")
}

model Address {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstname           String
  lastname            String
  address1            String
  address2            String?
  city                String
  zipcode             String
  phone               String
  state_name          String?
  alternative_phone   String?
  company             String?
  state_id            String          @db.Uuid
  state               State           @relation(fields: [state_id], references: [id], onDelete: Cascade)
  country_id          String?         @db.Uuid
  country             Country?        @relation("AddressToCountry", fields: [country_id], references: [id], onDelete: Cascade)
  user_id             String?         @db.Uuid
  cdmUser             CdmUser?        @relation("UserAddresses", fields: [user_id], references: [id])
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  deleted_at          DateTime?
  label               String?
  creditCards         CreditCard[]
  ordersAsBill        Order[]         @relation("OrderBillAddress")
  ordersAsShip        Order[]         @relation("OrderShipAddress")
  shipments           Shipment[]
  cdmUsersAsBill      CdmUser[]       @relation("UserBillAddress")
  cdmUsersAsShip      CdmUser[]       @relation("UserShipAddress")
  postalOffices       PostalOffice[]
  postalGuides        PostalGuide[]

  @@map("cdm_addresses")
}

// ============================================
// CDM USERS (separate from Auth User)
// ============================================

model CdmUser {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  encrypted_password       String?
  password_salt            String?
  name                     String?
  email                    String?
  remember_token           String?
  persistence_token        String?
  reset_password_token     String?
  perishable_token         String?
  sign_in_count            Int             @default(0)
  failed_attempts          Int             @default(0)
  last_request_at          DateTime?
  current_sign_in_at       DateTime?
  last_sign_in_at          DateTime?
  current_sign_in_ip       String?
  last_sign_in_ip          String?
  login                    String?
  ship_address_id          String?         @db.Uuid
  shipAddress              Address?        @relation("UserShipAddress", fields: [ship_address_id], references: [id])
  bill_address_id          String?         @db.Uuid
  billAddress              Address?        @relation("UserBillAddress", fields: [bill_address_id], references: [id])
  authentication_token     String?
  unlock_token             String?
  locked_at                DateTime?
  remember_created_at      DateTime?
  reset_password_sent_at   DateTime?
  created_at               DateTime        @default(now())
  updated_at               DateTime        @updatedAt
  addresses                Address[]       @relation("UserAddresses")
  orders                   Order[]
  creditCards              CreditCard[]
  roleUsers                RoleUser[]
  storeCredits             StoreCredit[]
  postalManifests          PostalManifest[]
  postalEvents             PostalEvent[]
  promotionRuleUsers       PromotionRuleUser[]
  stateChanges             StateChange[]

  @@map("cdm_users")
}

// ============================================
// PRODUCTS & INVENTORY
// ============================================

model Product {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String                  @default("")
  description           String?                 @db.Text
  available_on          DateTime?
  deleted_at            DateTime?
  slug                  String?
  meta_description      String?                 @db.Text
  meta_keywords         String?
  tax_category_id       String?                 @db.Uuid
  taxCategory           TaxCategory?            @relation(fields: [tax_category_id], references: [id])
  shipping_category_id  String?                 @db.Uuid
  shippingCategory      ShippingCategory?       @relation(fields: [shipping_category_id], references: [id])
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  promotionable         Boolean                 @default(true)
  meta_title            String?
  discontinue_on        DateTime?
  variants              Variant[]
  productOptionTypes    ProductOptionType[]
  productPromotionRules ProductPromotionRule[]
  productProperties     ProductProperty[]
  productsStores        ProductsStore[]
  productsTaxons        ProductsTaxon[]

  @@map("cdm_products")
}

model Variant {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                     String                @default("")
  weight                  Decimal?              @db.Decimal(8, 2)
  height                  Decimal?              @db.Decimal(8, 2)
  width                   Decimal?              @db.Decimal(8, 2)
  depth                   Decimal?              @db.Decimal(8, 2)
  deleted_at              DateTime?
  is_master               Boolean               @default(false)
  product_id              String?               @db.Uuid
  product                 Product?              @relation(fields: [product_id], references: [id])
  cost_price              Decimal?              @db.Decimal(10, 2)
  position                 Int?
  cost_currency           String?
  track_inventory         Boolean               @default(true)
  tax_category_id         String?               @db.Uuid
  taxCategory             TaxCategory?          @relation(fields: [tax_category_id], references: [id])
  updated_at              DateTime              @updatedAt
  discontinue_on          DateTime?
  created_at              DateTime              @default(now())
  prices                  Price[]
  lineItems               LineItem[]
  inventoryUnits          InventoryUnit[]
  stockItems              StockItem[]
  optionValueVariants     OptionValueVariant[]
  promotionActionLineItems PromotionActionLineItem[]
  returnItems             ReturnItem[]
  stockTransfers          StockTransfer[]

  @@map("cdm_variants")
}

model Price {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variant_id        String    @db.Uuid
  variant           Variant   @relation(fields: [variant_id], references: [id])
  amount            Decimal?  @db.Decimal(10, 2)
  currency          String?
  deleted_at        DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  compare_at_amount Decimal?  @db.Decimal(10, 2)

  @@map("cdm_prices")
}

model OptionType {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String?
  presentation          String?
  position              Int                 @default(0)
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt
  filterable            Boolean             @default(true)
  optionValues          OptionValue[]
  productOptionTypes    ProductOptionType[]
  optionTypePrototypes  OptionTypePrototype[]

  @@map("cdm_option_types")
}

model OptionValue {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  position            Int?
  name                String?
  presentation        String?
  option_type_id      String?               @db.Uuid
  optionType          OptionType?           @relation(fields: [option_type_id], references: [id])
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  optionValueVariants OptionValueVariant[]

  @@map("cdm_option_values")
}

model OptionValueVariant {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variant_id      String?      @db.Uuid
  variant         Variant?     @relation(fields: [variant_id], references: [id])
  option_value_id String?      @db.Uuid
  optionValue     OptionValue? @relation(fields: [option_value_id], references: [id])
  created_at      DateTime?
  updated_at      DateTime?

  @@map("cdm_option_value_variants")
}

model ProductOptionType {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  position       Int?
  product_id     String?     @db.Uuid
  product        Product?    @relation(fields: [product_id], references: [id])
  option_type_id String?     @db.Uuid
  optionType     OptionType? @relation(fields: [option_type_id], references: [id])
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  @@map("cdm_product_option_types")
}

// ============================================
// Manejo de inventario
// ============================================

model StockLocation {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  default               Boolean          @default(false)
  address1              String?
  address2              String?
  city                  String?
  state_id              String?          @db.Uuid
  state                 State?           @relation(fields: [state_id], references: [id])
  state_name            String?
  country_id            String?          @db.Uuid
  country               Country?         @relation(fields: [country_id], references: [id])
  zipcode               String?
  phone                 String?
  active                Boolean          @default(true)
  backorderable_default Boolean          @default(false)
  propagate_all_variants Boolean         @default(true)
  admin_name            String?
  stockItems            StockItem[]
  customerReturns       CustomerReturn[]
  returnAuthorizations  ReturnAuthorization[]
  shipments             Shipment[]
  stockTransfersAsSource StockTransfer[] @relation("SourceLocation")
  stockTransfersAsDest  StockTransfer[]  @relation("DestLocation")
  postalOffices         PostalOffice[]

  @@map("cdm_stock_locations")
}

model StockItem {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stock_location_id String?         @db.Uuid
  stockLocation     StockLocation?  @relation(fields: [stock_location_id], references: [id])
  variant_id        String?         @db.Uuid
  variant           Variant?        @relation(fields: [variant_id], references: [id])
  count_on_hand     Int             @default(0)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  backorderable     Boolean         @default(false)
  deleted_at        DateTime?
  stockMovements    StockMovement[]
  stockReservations StockReservation[]

  @@map("cdm_stock_items")
}

model StockMovement {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stock_item_id  String?    @db.Uuid
  stockItem      StockItem? @relation(fields: [stock_item_id], references: [id])
  quantity       Int        @default(0)
  action         String?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  originator_type String?
  originator_id  String?    @db.Uuid

  @@map("cdm_stock_movements")
}

model StockReservation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stock_item_id   String    @db.Uuid
  stockItem       StockItem @relation(fields: [stock_item_id], references: [id])
  quantity        Int
  status          String    @default("pending")
  originator_type String?
  originator_id   String?   @db.Uuid
  expires_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([stock_item_id, status])
  @@map("cdm_stock_reservations")
}

model StockTransfer {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                    String?
  reference               String?
  source_location_id      String?        @db.Uuid
  sourceLocation          StockLocation? @relation("SourceLocation", fields: [source_location_id], references: [id])
  destination_location_id String?        @db.Uuid
  destinationLocation     StockLocation? @relation("DestLocation", fields: [destination_location_id], references: [id])
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt
  number                  String?
  status                  String         @default("pending")
  variant_id              String?        @db.Uuid
  variant                 Variant?       @relation(fields: [variant_id], references: [id])
  quantity                Int            @default(0)
  completed_at            DateTime?
  cancelled_at            DateTime?

  @@index([variant_id, status])
  @@index([source_location_id, destination_location_id])
  @@map("cdm_stock_transfers")
}

// ============================================
// orders
// ============================================

model Order {
  id                         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number                     String?
  item_total                 Decimal          @default(0.0) @db.Decimal(10, 2)
  total                      Decimal          @default(0.0) @db.Decimal(10, 2)
  state                      String?
  adjustment_total           Decimal          @default(0.0) @db.Decimal(10, 2)
  user_id                    String?          @db.Uuid
  cdmUser                    CdmUser?         @relation(fields: [user_id], references: [id])
  completed_at               DateTime?
  bill_address_id            String?          @db.Uuid
  billAddress                Address?         @relation("OrderBillAddress", fields: [bill_address_id], references: [id])
  ship_address_id            String?          @db.Uuid
  shipAddress                Address?         @relation("OrderShipAddress", fields: [ship_address_id], references: [id])
  payment_total              Decimal          @default(0.0) @db.Decimal(10, 2)
  shipment_state             String?
  payment_state              String?
  email                      String?
  special_instructions       String?          @db.Text
  created_at                 DateTime         @default(now())
  updated_at                 DateTime         @updatedAt
  currency                   String?
  last_ip_address            String?
  created_by_id              String?          @db.Uuid
  shipment_total             Decimal          @default(0.0) @db.Decimal(10, 2)
  additional_tax_total       Decimal          @default(0.0) @db.Decimal(10, 2)
  promo_total                Decimal          @default(0.0) @db.Decimal(10, 2)
  channel                    String           @default("cdm")
  included_tax_total         Decimal          @default(0.0) @db.Decimal(10, 2)
  item_count                 Int              @default(0)
  approver_id                String?          @db.Uuid
  approved_at                DateTime?
  confirmation_delivered     Boolean          @default(false)
  considered_risky           Boolean          @default(false)
  token                      String?
  canceled_at                DateTime?
  canceler_id                String?          @db.Uuid
  store_id                   String?          @db.Uuid
  store                      Store?           @relation(fields: [store_id], references: [id])
  state_lock_version         Int              @default(0)
  taxable_adjustment_total   Decimal          @default(0.0) @db.Decimal(10, 2)
  non_taxable_adjustment_total Decimal        @default(0.0) @db.Decimal(10, 2)
  store_owner_notification_delivered Boolean?
  lineItems                  LineItem[]
  adjustments                Adjustment[]
  inventoryUnits             InventoryUnit[]
  payments                   Payment[]
  shipments                  Shipment[]
  orderPromotions            OrderPromotion[]
  reimbursements             Reimbursement[]
  returnAuthorizations       ReturnAuthorization[]

  @@map("cdm_orders")
}

model LineItem {
  id                             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variant_id                     String?         @db.Uuid
  variant                        Variant?        @relation(fields: [variant_id], references: [id])
  order_id                       String?         @db.Uuid
  order                          Order?          @relation(fields: [order_id], references: [id])
  quantity                       Int
  price                          Decimal         @db.Decimal(10, 2)
  created_at                     DateTime        @default(now())
  updated_at                     DateTime        @updatedAt
  currency                       String?
  cost_price                     Decimal?        @db.Decimal(10, 2)
  tax_category_id                String?         @db.Uuid
  taxCategory                    TaxCategory?    @relation(fields: [tax_category_id], references: [id])
  adjustment_total               Decimal         @default(0.0) @db.Decimal(10, 2)
  additional_tax_total           Decimal         @default(0.0) @db.Decimal(10, 2)
  promo_total                    Decimal         @default(0.0) @db.Decimal(10, 2)
  included_tax_total             Decimal         @default(0.0) @db.Decimal(10, 2)
  pre_tax_amount                 Decimal         @default(0.0) @db.Decimal(12, 4)
  taxable_adjustment_total       Decimal         @default(0.0) @db.Decimal(10, 2)
  non_taxable_adjustment_total   Decimal         @default(0.0) @db.Decimal(10, 2)
  inventoryUnits                 InventoryUnit[]

  @@map("cdm_line_items")
}

model InventoryUnit {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state                 String?
  variant_id            String?      @db.Uuid
  variant               Variant?     @relation(fields: [variant_id], references: [id])
  order_id              String?      @db.Uuid
  order                 Order?       @relation(fields: [order_id], references: [id])
  shipment_id           String?      @db.Uuid
  shipment              Shipment?    @relation(fields: [shipment_id], references: [id])
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt
  pending               Boolean      @default(true)
  line_item_id          String?      @db.Uuid
  lineItem              LineItem?    @relation(fields: [line_item_id], references: [id])
  quantity              Int          @default(1)
  original_return_item_id String?    @db.Uuid
  returnItems           ReturnItem[]

  @@map("cdm_inventory_units")
}

model Adjustment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_type      String?
  source_id        String?  @db.Uuid
  adjustable_type  String?
  adjustable_id    String?  @db.Uuid
  amount           Decimal? @db.Decimal(10, 2)
  label            String?
  mandatory        Boolean?
  eligible         Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  state            String?
  order_id         String   @db.Uuid
  order            Order    @relation(fields: [order_id], references: [id])
  included         Boolean  @default(false)

  @@map("cdm_adjustments")
}

// ============================================
// payments
// ============================================

model PaymentMethod {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                   String?
  name                   String?
  description            String?                  @db.Text
  active                 Boolean                  @default(true)
  deleted_at             DateTime?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt
  display_on             String                   @default("both")
  auto_capture           Boolean?
  preferences            String?                  @db.Text
  position               Int                      @default(0)
  payments               Payment[]
  creditCards            CreditCard[]
  paymentMethodsStores   PaymentMethodsStore[]

  @@map("cdm_payment_methods")
}

model PaymentMethodsStore {
  payment_method_id String         @db.Uuid
  paymentMethod     PaymentMethod  @relation(fields: [payment_method_id], references: [id])
  store_id          String         @db.Uuid
  store             Store          @relation(fields: [store_id], references: [id])

  @@id([payment_method_id, store_id])
  @@map("cdm_payment_methods_stores")
}

model Payment {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount               Decimal                @default(0.0) @db.Decimal(10, 2)
  order_id             String?                @db.Uuid
  order                Order?                 @relation(fields: [order_id], references: [id])
  source_type          String?
  source_id            String?                @db.Uuid
  payment_method_id    String?                @db.Uuid
  paymentMethod        PaymentMethod?         @relation(fields: [payment_method_id], references: [id])
  state                String?
  response_code        String?
  avs_response         String?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  number               String?
  cvv_response_code    String?
  cvv_response_message String?
  gateway_code         String?
  payment_intent_id    String?
  captured_amount      Decimal                @default(0.0) @db.Decimal(10, 2)
  gateway_metadata     Json?
  paymentCaptureEvents PaymentCaptureEvent[]
  refunds              Refund[]
  paymentWebhookEvents PaymentWebhookEvent[]

  @@index([payment_intent_id])
  @@map("cdm_payments")
}

model PaymentCaptureEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount     Decimal  @default(0.0) @db.Decimal(10, 2)
  payment_id String?  @db.Uuid
  payment    Payment? @relation(fields: [payment_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("cdm_payment_capture_events")
}

model CreditCard {
  id                          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  month                       String?
  year                        String?
  cc_type                     String?
  last_digits                 String?
  address_id                  String?        @db.Uuid
  address                     Address?       @relation(fields: [address_id], references: [id])
  gateway_customer_profile_id String?
  gateway_payment_profile_id  String?
  created_at                  DateTime       @default(now())
  updated_at                  DateTime       @updatedAt
  name                        String?
  user_id                     String?        @db.Uuid
  cdmUser                     CdmUser?       @relation(fields: [user_id], references: [id])
  payment_method_id           String?        @db.Uuid
  paymentMethod               PaymentMethod? @relation(fields: [payment_method_id], references: [id])
  default                     Boolean        @default(false)
  deleted_at                  DateTime?

  @@map("cdm_credit_cards")
}

// ============================================
// Shippng
// ============================================

model Shipment {
  id                            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tracking                      String?
  number                        String?
  cost                          Decimal        @default(0.0) @db.Decimal(10, 2)
  shipped_at                    DateTime?
  order_id                      String?        @db.Uuid
  order                         Order?         @relation(fields: [order_id], references: [id])
  address_id                    String?        @db.Uuid
  address                       Address?       @relation(fields: [address_id], references: [id])
  state                         String?
  created_at                    DateTime       @default(now())
  updated_at                    DateTime       @updatedAt
  stock_location_id             String?        @db.Uuid
  stockLocation                 StockLocation? @relation(fields: [stock_location_id], references: [id])
  adjustment_total              Decimal        @default(0.0) @db.Decimal(10, 2)
  additional_tax_total          Decimal        @default(0.0) @db.Decimal(10, 2)
  promo_total                   Decimal        @default(0.0) @db.Decimal(10, 2)
  included_tax_total            Decimal        @default(0.0) @db.Decimal(10, 2)
  pre_tax_amount                Decimal        @default(0.0) @db.Decimal(12, 4)
  taxable_adjustment_total      Decimal        @default(0.0) @db.Decimal(10, 2)
  non_taxable_adjustment_total  Decimal        @default(0.0) @db.Decimal(10, 2)
  inventoryUnits                InventoryUnit[]
  shippingRates                 ShippingRate[]
  postalGuide                   PostalGuide?
  pending_at                    DateTime?

  @@map("cdm_shipments")
}

model ShippingMethod {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String?
